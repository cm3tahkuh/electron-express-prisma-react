generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id(map: "PK_User") @default(autoincrement())
  name     String? @db.NVarChar(50)
  password String? @db.NVarChar(50)
  age      Int?
}
