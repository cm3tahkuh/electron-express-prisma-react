{
  "compilerOptions": {
    "baseUrl": "./src/frontend/",
    "paths": {
      "@styles/*": ["styles/*"],
      "@pages/*": ["pages/*"],
      "@widgets/*": ["widgets/*"],
      "@shared/*": ["shared/*"],
      "@store/*": ["store/*"],
      "@api/*": ["api/*"]
    },
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
